#!/bin/sh
# states/clean/gate: benchmark regression check after the agent commits.
#
# Runs only on iterations that produced commits, per [gate] run_when="commits-only".
# soft_fail=true → regression surfaces in next prompt's {{.GateResult}}, the FSM
# does NOT enter failed{}. Mirrors run_benchmark_gate() from the legacy
# run_optimization_loop.py and the .github/workflows/ci.yml::benchmark_regression
# job (--rust-only --skip-bimodal --threshold 0.15).
#
# Env: RALPH_REPO RALPH_ITER RALPH_STATE RALPH_PROMPT_FILE RALPH_ITER_JSON

set -e
export PATH="$HOME/.cargo/bin:$PATH"
# shellcheck disable=SC1091
. /home/ubuntu/repos/angr/.venv/bin/activate

exec python tests/benchmarks/run_regression.py \
    --rust-only --skip-bimodal --threshold 0.15
