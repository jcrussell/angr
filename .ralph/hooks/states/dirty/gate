#!/bin/sh
# states/dirty/gate: same post-commit regression gate as clean/gate.
# The dirty state can still produce commits when the agent salvages prior
# in-progress work, so the gate must run there too.
#
# Thin wrapper — the checks live in tools/ralph-gate.sh, shared with clean/gate.
#
# Env: RALPH_REPO RALPH_ITER RALPH_STATE RALPH_PROMPT_FILE RALPH_ITER_JSON

exec /home/ubuntu/repos/angr/tools/ralph-gate.sh "$@"
